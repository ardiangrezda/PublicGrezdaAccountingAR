@page "/purchases/create"
@page "/purchases/create/{Category}"
@page "/purchases/edit/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq
@using Models
@using Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Models.Enums
@inject PurchaseService PurchaseService
@inject ArticleService ArticleService
@inject SubjectService SubjectService
@inject BusinessUnitService BusinessUnitService
@inject TradingAgentService TradingAgentService
@inject ILocalizationService LocalizationService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject StateContainer StateContainer
@attribute [Authorize]

<style>
    .table th {
        font-size: 0.85rem;
        padding: 0.5rem;
        background-color: #4CAF50 !important;
        color: white;
    }

    .table td {
        padding: 0.25rem;
        vertical-align: middle;
        font-size: 0.85rem;
    }

    .table tr.totals-row {
        background-color: #E8F5E9;
        font-weight: bold;
    }

    .btn-add-item {
        background-color: #E8F5E9;
        color: #2e7d32;
        border: 1px solid #c8e6c9;
        box-shadow: none;
        padding: .35rem .6rem;
        border-radius: .25rem;
    }

        .btn-add-item:hover,
        .btn-add-item:focus {
            background-color: #c8e6c9;
            color: #1b5e20;
            text-decoration: none;
        }

    .form-control-sm, .form-select-sm {
        padding: 0.25rem 0.5rem;
        height: calc(1.5em + 0.5rem + 2px);
        font-size: 0.875rem;
    }

    .invoice-summary {
        background-color: #4CAF50 !important;
        color: white;
        padding: 0.5rem 1rem;
        margin-bottom: 1rem;
    }

    .total-due {
        background-color: #4CAF50 !important;
        color: white;
        padding: 0.5rem 1rem;
    }

    .search-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        max-height: 300px;
        overflow-y: auto;
        z-index: 1050;
        min-width: 400px;
        width: max-content;
    }

    .search-item {
        cursor: pointer;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid #f8f9fa;
    }

        .search-item:hover {
            background-color: #f8f9fa;
        }

    .position-relative {
        position: relative !important;
    }

    .table-responsive {
        overflow: visible !important;
    }

    .no-spin::-webkit-outer-spin-button,
    .no-spin::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .no-spin {
        -moz-appearance: textfield;
    }

    .header-section {
        background-color: #f8f9fa;
        border-radius: 0.5rem;
        padding: 1rem;
        border: 1px solid #dee2e6;
    }

    .invoice-header {
        background-color: #f8f9fa;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #dee2e6;
        border-top-left-radius: 0.5rem;
        border-top-right-radius: 0.5rem;
    }

    .invoice-header h1 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .invoice-header .badge {
        font-size: 0.875rem;
        padding: 0.25rem 0.5rem;
    }

    .invoice-header .btn {
        min-width: 100px;
    }
</style>

<ErrorBoundary @ref="errorBoundary">
    <ChildContent>
        @if (purchase != null && editContext != null)
        {
            <EditForm EditContext="editContext" OnValidSubmit="@HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="invoice-page">
                    <!-- Top Action Bar -->
                    <div class="invoice-header bg-light border-bottom p-4 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h1 class="mb-0">@pageTitle</h1>
                                <div class="text-muted small">
                                    @(IsEdit ? $"{invoiceNumberLabel}: {purchase.InvoiceNumber}" : newPurchaseLabel)
                                    @if (currentCategoryName != null)
                                    {
                                        <span class="ms-2 badge bg-info">@currentCategoryName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(currentBusinessUnitName))
                                    {
                                        <span class="ms-2 badge bg-success">@currentBusinessUnitName</span>
                                    }
                                </div>
                            </div>
                            <div>
                                <button type="button" class="btn btn-outline-secondary me-2" @onclick="GoBack">
                                    <i class="fas fa-arrow-left"></i> @backLabel
                                </button>
                                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-save"></i>
                                    }
                                    @saveLabel
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="container-fluid px-4">
                        <div class="card mb-4 shadow-sm">
                            <div class="card-body">
                                <!-- 3-Column Header Layout -->
                                <div class="row mb-4">
                                    <!-- Column 1: Supplier & Dates -->
                                    <div class="col-md-4">
                                        <div class="header-section h-100">
                                            <h6 class="border-bottom pb-2 mb-3 text-primary"><i class="fas fa-user me-2"></i>@supplierLabel</h6>

                                            <div class="mb-2">
                                                <label class="form-label fw-bold small">@supplierLabel</label>
                                                <div class="position-relative">
                                                    <input value="@purchase.SupplierName"
                                                           @oninput="HandleSupplierSearch"
                                                           class="@($"form-control form-control-sm {(purchase.SupplierId <= 0 ? "border-danger" : "")}")"
                                                           placeholder="@startTypingSupplierLabel" />
                                                    @if (showSupplierSearch && supplierSearchResults.Any())
                                                    {
                                                        <div class="search-dropdown">
                                                            @foreach (var supplier in supplierSearchResults)
                                                            {
                                                                <div class="search-item" @onclick="() => SelectSupplier(supplier)">
                                                                    <div class="fw-bold">@supplier.SubjectName</div>
                                                                    <small class="text-muted">@supplier.Code</small>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-6">
                                                    <div class="mb-2">
                                                        <label class="form-label fw-bold small">@dateLabel</label>
                                                        <InputDate @bind-Value="purchase.InvoiceDate" class="form-control form-control-sm" />
                                                        <ValidationMessage For="@(() => purchase.InvoiceDate)" class="text-danger small" />
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="mb-2">
                                                        <label class="form-label fw-bold small">@expiryDateLabel</label>
                                                        <InputDate @bind-Value="purchase.InvoiceExpiryDate" class="form-control form-control-sm" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Column 2: Logistics & Reference -->
                                    <div class="col-md-4">
                                        <div class="header-section h-100">
                                            <h6 class="border-bottom pb-2 mb-3 text-primary"><i class="fas fa-truck me-2"></i>@logisticsLabel</h6>

                                            <div class="mb-2">
                                                <label class="form-label fw-bold small">@tradingAgentLabel</label>
                                                <InputSelect @bind-Value="purchase.TradingAgentId" class="form-select form-select-sm">
                                                    <option value="">@selectAgentLabel</option>
                                                    @foreach (var agent in tradingAgents)
                                                    {
                                                        <option value="@agent.Id">@agent.Name</option>
                                                    }
                                                </InputSelect>
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label fw-bold small">@shipmentLabel</label>
                                                <InputText @bind-Value="purchase.Shipment" class="form-control form-control-sm" placeholder="@transportRefPlaceholderLabel" />
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label fw-bold small">@locationLabel</label>
                                                <input type="text" class="form-control form-control-sm" value="@currentBusinessUnitName" readonly disabled />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Column 3: Financials & References -->
                                    <div class="col-md-4">
                                        <div class="header-section h-100">
                                            <h6 class="border-bottom pb-2 mb-3 text-primary">
                                                <i class="fas fa-file-invoice-dollar me-2"></i>@invoiceReferencesLabel
                                            </h6>

                                            <!-- EXTERNAL/SUPPLIER INVOICE NUMBER (Editable) -->
                                            <div class="mb-2">
                                                <label class="form-label fw-bold small">
                                                    @supplierInvoiceNumberLabel <span class="text-danger">*</span>
                                                </label>
                                                <InputText @bind-Value="purchase.ExternalInvoiceNumber" 
                                                           class="form-control form-control-sm" 
                                                           placeholder="e.g. SUP-12345" 
                                                           required />
                                                <small class="text-muted">@enterInvoiceNumberFromSupplierLabel</small>
                                            </div>

                                            <!-- Financial Summary (keep existing) -->
                                            <div class="mt-3 p-2 bg-white border rounded">
                                                <div class="d-flex justify-content-between mb-1">
                                                    <span class="small">@subtotalLabel:</span>
                                                    <span class="fw-bold small">@((purchase.TotalWithoutVAT + purchase.TotalDiscountAmount).ToString("N2"))</span>
                                                </div>
                                                <div class="d-flex justify-content-between mb-1">
                                                    <span class="small">@vatLabel:</span>
                                                    <span class="fw-bold small">@purchase.TotalVATAmount.ToString("N2")</span>
                                                </div>
                                                <div class="d-flex justify-content-between border-top pt-1 mt-1">
                                                    <span class="fw-bold text-success">@totalDueLabel:</span>
                                                    <span class="fw-bold text-success">@purchase.TotalWithVAT.ToString("N2")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Items Grid -->
                                <div class="row">
                                    <div class="col-12">
                                        <h5 class="mb-3">@itemsLabel</h5>
                                        <div class="table-responsive">
                                            <table class="table table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 40px">#</th>
                                                        <th style="width: 150px">@articleLabel</th>
                                                        <th style="width: 200px">@descriptionLabel</th>
                                                        <th style="width: 80px" class="text-end">@quantityLabel</th>
                                                        <th style="width: 80px" class="text-center">@unitLabel</th>
                                                        <th style="width: 120px" class="text-end">@priceExclLabel</th>
                                                        <th style="width: 120px" class="text-end">@priceInclLabel</th>
                                                        <th style="width: 100px" class="text-end">@discPercentLabel</th>
                                                        <th style="width: 120px" class="text-end">@discAmountLabel</th>
                                                        <th style="width: 120px" class="text-end">@valueExclLabel</th>
                                                        <th style="width: 120px" class="text-end">@valueInclLabel</th>
                                                        <th style="width: 40px"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (purchase.Items != null && purchase.Items.Count > 0)
                                                    {
                                                        @foreach (var (item, index) in purchase.Items.Select((item, i) => (item, i + 1)))
                                                        {
                                                            <tr>
                                                                <td class="text-center">@index</td>
                                                                <td>
                                                                    <div class="position-relative">
                                                                        <input type="text"
                                                                               class="form-control form-control-sm"
                                                                               value="@item.Barcode"
                                                                               @oninput="(e) => HandleBarcodeSearch(e, item)"
                                                                               @onfocus="() => SetActiveSearchItem(item)"
                                                                               @onblur="() => HandleBarcodeChange(item)" />
                                                                        @if (activeSearchItem == item && showBarcodeSearch && barcodeSearchResults.Any())
                                                                        {
                                                                            <div class="search-dropdown">
                                                                                @foreach (var article in barcodeSearchResults)
                                                                                {
                                                                                    <div class="search-item" @onmousedown="() => SelectArticle(article, item)">
                                                                                        <div><strong>@article.Barcode</strong> - @article.Description</div>
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="position-relative">
                                                                        <input type="text"
                                                                               class="form-control form-control-sm"
                                                                               value="@item.Description"
                                                                               @oninput="(e) => HandleDescriptionSearch(e, item)"
                                                                               @onfocus="() => SetActiveSearchItem(item)"
                                                                               placeholder="@startTypingDescriptionLabel" />
                                                                        @if (activeSearchItem == item && showArticleSearch && articleSearchResults.Any())
                                                                        {
                                                                            <div class="search-dropdown">
                                                                                @foreach (var article in articleSearchResults)
                                                                                {
                                                                                    <div class="search-item" @onclick="() => SelectArticle(article, item)">
                                                                                        <div>@article.Description</div>
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <input type="number"
                                                                           class="form-control form-control-sm text-end"
                                                                           value="@item.Quantity"
                                                                           @onchange="(e) => HandleQuantityChange(e, item)"
                                                                           step="0.01" />
                                                                </td>
                                                                <td class="text-center">@item.UnitCode</td>
                                                                <td class="text-end">
                                                                    <input type="number" class="form-control form-control-sm text-end no-spin"
                                                                           step="0.01"
                                                                           @bind="item.PriceWithoutVAT" @bind:event="oninput"
                                                                           @onblur="() => OnPriceWithoutVatBlurAsync(item)" />
                                                                </td>
                                                                <td class="text-end">
                                                                    <input type="number" class="form-control form-control-sm text-end no-spin"
                                                                           step="0.01"
                                                                           @bind="item.PriceWithVAT"
                                                                           @bind:event="oninput"
                                                                           @onblur="() => OnPriceWithVatBlurAsync(item)" />
                                                                </td>
                                                                <td>
                                                                    <input type="number" class="form-control form-control-sm text-end"
                                                                           @bind="item.DiscountPercent"
                                                                           @bind:event="oninput"
                                                                           @onblur="() => CalculateItemTotal(item)" />
                                                                </td>
                                                                <td class="text-end">@item.DiscountAmount.ToString("N2")</td>
                                                                <td class="text-end">@item.ValueWithoutVAT.ToString("N2")</td>
                                                                <td class="text-end">@item.ValueWithVAT.ToString("N2")</td>
                                                                <td>
                                                                    <button type="button" class="btn btn-outline-danger btn-remove" @onclick="() => RemoveItem(item)">
                                                                        <i class="fas fa-times"></i>
                                                                    </button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="12" class="text-center text-muted">
                                                                @noItemsAddedYetLabel
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr class="totals-row">
                                                        <td colspan="2">
                                                            <button type="button" class="btn btn-add-item btn-sm me-2" @onclick="AddNewItem">
                                                                <i class="fas fa-plus"></i> @addItemLabel
                                                            </button>
                                                        </td>
                                                        <td colspan="5"></td>
                                                        <td class="text-end">@totalsLabel</td>
                                                        <td class="text-end">@purchase.TotalDiscountAmount.ToString("N2")</td>
                                                        <td class="text-end">@purchase.TotalWithoutVAT.ToString("N2")</td>
                                                        <td class="text-end">@purchase.TotalWithVAT.ToString("N2")</td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>
        }
        else if (loading)
        {
            <div class="text-center p-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">@loadingLabel</span>
                </div>
            </div>
        }
    </ChildContent>
    <ErrorContent>
        <div class="alert alert-danger">
            <h4>@errorOccurredLabel</h4>
            <button class="btn btn-secondary" @onclick="ResetError">@tryAgainLabel</button>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public string? Category { get; set; }

    private PurchaseInvoice purchase = new();
    private bool loading = true;
    private bool isSaving = false;
    private bool IsEdit => Id.HasValue;
    private EditContext? editContext;
    private ErrorBoundary? errorBoundary;

    private string? currentCategoryName;
    private string? currentBusinessUnitName;

    // Search states
    private List<Subject> supplierSearchResults = new();
    private bool showSupplierSearch = false;
    private List<Article> articleSearchResults = new();
    private bool showArticleSearch = false;
    private List<Article> barcodeSearchResults = new();
    private bool showBarcodeSearch = false;
    private PurchaseInvoiceItem? activeSearchItem;

    // Data sources
    private List<TradingAgent> tradingAgents = new();

    // Localization
    private string pageTitle = string.Empty;
    private string newPurchaseLabel = string.Empty;
    private string invoiceNumberLabel = string.Empty;
    private string dateLabel = string.Empty;
    private string expiryDateLabel = string.Empty;
    private string supplierLabel = string.Empty;
    private string startTypingSupplierLabel = string.Empty;
    private string itemsLabel = string.Empty;
    private string articleLabel = string.Empty;
    private string descriptionLabel = string.Empty;
    private string quantityLabel = string.Empty;
    private string unitLabel = string.Empty;
    private string priceExclLabel = string.Empty;
    private string priceInclLabel = string.Empty;
    private string discPercentLabel = string.Empty;
    private string discAmountLabel = string.Empty;
    private string valueExclLabel = string.Empty;
    private string valueInclLabel = string.Empty;
    private string noItemsAddedYetLabel = string.Empty;
    private string addItemLabel = string.Empty;
    private string totalsLabel = string.Empty;
    private string summaryLabel = string.Empty;
    private string subtotalLabel = string.Empty;
    private string discountLabel = string.Empty;
    private string vatLabel = string.Empty;
    private string totalDueLabel = string.Empty;
    private string saveLabel = string.Empty;
    private string backLabel = string.Empty;
    private string loadingLabel = string.Empty;
    private string startTypingDescriptionLabel = string.Empty;
    private string tradingAgentLabel = string.Empty;
    private string shipmentLabel = string.Empty;
    private string pleaseAddOneItemLabel = string.Empty;
    private string invoiceNotFoundLabel = string.Empty;
    private string supplierInvoiceNumberLabel = string.Empty;
    
    private string locationLabel = string.Empty;
    private string enterInvoiceNumberFromSupplierLabel = string.Empty;
    private string logisticsLabel = string.Empty;
    private string invoiceReferencesLabel = string.Empty;
    private string purchaseCreatedSuccessLabel = string.Empty;
    private string purchaseUpdatedSuccessLabel = string.Empty;
    private string pleaseSelectSupplierLabel = string.Empty;
    private string pleaseEnterSupplierInvoiceNumberLabel = string.Empty;
    private string purchaseCannotBeEditedLabel = string.Empty;
    private string errorLoadingAgentsLabel = string.Empty;
    private string errorOccurredLabel = string.Empty;
    private string tryAgainLabel = string.Empty;
    private string transportRefPlaceholderLabel = string.Empty;
    private string selectAgentLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadLocalizationStrings();
        await LoadTradingAgents();
        await LoadPurchase();
    }

    private async Task LoadLocalizationStrings()
    {
        var languageId = await LocalizationService.GetDefaultLanguageId();
        // Using existing keys where possible, falling back to defaults
        pageTitle = LocalizationService.GetString("STRING_00173", languageId) ?? "Purchases";
        newPurchaseLabel = LocalizationService.GetString("STRING_00337", languageId) ?? "New Purchase";
        invoiceNumberLabel = LocalizationService.GetString("STRING_00139", languageId) ?? "Invoice #";
        dateLabel = LocalizationService.GetString("STRING_00140", languageId) ?? "Date";
        expiryDateLabel = LocalizationService.GetString("STRING_00120", languageId) ?? "Expiry Date";
        supplierLabel = LocalizationService.GetString("STRING_00055", languageId) ?? "Supplier";
        itemsLabel = LocalizationService.GetString("STRING_00116", languageId) ?? "Items";
        articleLabel = LocalizationService.GetString("STRING_00123", languageId) ?? "Article";
        descriptionLabel = LocalizationService.GetString("STRING_00028", languageId) ?? "Description";
        quantityLabel = LocalizationService.GetString("STRING_00124", languageId) ?? "Qty";
        unitLabel = LocalizationService.GetString("STRING_00013", languageId) ?? "Unit";
        priceExclLabel = LocalizationService.GetString("STRING_00125", languageId) ?? "Price Excl.";
        priceInclLabel = LocalizationService.GetString("STRING_00126", languageId) ?? "Price Incl.";
        discPercentLabel = LocalizationService.GetString("STRING_00127", languageId) ?? "Disc %";
        discAmountLabel = LocalizationService.GetString("STRING_00128", languageId) ?? "Disc Amt";
        valueExclLabel = LocalizationService.GetString("STRING_00129", languageId) ?? "Value Excl.";
        valueInclLabel = LocalizationService.GetString("STRING_00130", languageId) ?? "Value Incl.";
        totalsLabel = LocalizationService.GetString("STRING_00131", languageId) ?? "Totals:";
        summaryLabel = LocalizationService.GetString("STRING_00132", languageId) ?? "Summary";
        subtotalLabel = LocalizationService.GetString("STRING_00133", languageId) ?? "Subtotal";
        discountLabel = LocalizationService.GetString("STRING_00134", languageId) ?? "Discount";
        vatLabel = LocalizationService.GetString("STRING_00135", languageId) ?? "VAT";
        totalDueLabel = LocalizationService.GetString("STRING_00136", languageId) ?? "Total Due";
        saveLabel = LocalizationService.GetString("STRING_00024", languageId) ?? "Save";
        backLabel = LocalizationService.GetString("STRING_00142", languageId) ?? "Back";
        loadingLabel = LocalizationService.GetString("STRING_00266", languageId) ?? "Loading...";

        tradingAgentLabel = LocalizationService.GetString("STRING_00333", languageId) ?? "Trading Agent";
        startTypingSupplierLabel = LocalizationService.GetString("STRING_00338", languageId) ?? "Start typing supplier...";
        noItemsAddedYetLabel = LocalizationService.GetString("STRING_00138", languageId) ?? "No items added yet.";
        addItemLabel = LocalizationService.GetString("STRING_00122", languageId) ?? "Add Item";
        startTypingDescriptionLabel = LocalizationService.GetString("STRING_00143", languageId) ?? "Start typing description...";
        shipmentLabel = LocalizationService.GetString("STRING_00339", languageId) ?? "Shipment";
        pleaseAddOneItemLabel = LocalizationService.GetString("STRING_00111", languageId) ?? "Please add at least one item.";
        invoiceNotFoundLabel = LocalizationService.GetString("STRING_00171", languageId) ?? "Invoice Not Found";
        supplierInvoiceNumberLabel = LocalizationService.GetString("STRING_00349", languageId) ?? "Supplier Invoice #";

        locationLabel = LocalizationService.GetString("STRING_00368", languageId) ?? "Location";
        enterInvoiceNumberFromSupplierLabel = LocalizationService.GetString("STRING_00369", languageId) ?? "Enter the invoice number from the supplier";
        logisticsLabel = LocalizationService.GetString("STRING_00370", languageId) ?? "Logistics";
        invoiceReferencesLabel = LocalizationService.GetString("STRING_00371", languageId) ?? "Invoice References";
        purchaseCreatedSuccessLabel = LocalizationService.GetString("STRING_00372", languageId) ?? "Purchase created successfully!";
        purchaseUpdatedSuccessLabel = LocalizationService.GetString("STRING_00373", languageId) ?? "Purchase updated successfully!";
        pleaseSelectSupplierLabel = LocalizationService.GetString("STRING_00374", languageId) ?? "Please select a supplier.";
        pleaseEnterSupplierInvoiceNumberLabel = LocalizationService.GetString("STRING_00375", languageId) ?? "Please enter the supplier's invoice number.";
        purchaseCannotBeEditedLabel = LocalizationService.GetString("STRING_00376", languageId) ?? "This purchase cannot be edited because its status is '{0}'. Only Draft purchases can be edited.";
        errorLoadingAgentsLabel = LocalizationService.GetString("STRING_00377", languageId) ?? "Error loading agents";
        errorOccurredLabel = LocalizationService.GetString("STRING_00378", languageId) ?? "An error occurred";
        tryAgainLabel = LocalizationService.GetString("STRING_00379", languageId) ?? "Try Again";
        transportRefPlaceholderLabel = LocalizationService.GetString("STRING_00380", languageId) ?? "Transport Ref...";
        selectAgentLabel = LocalizationService.GetString("STRING_00381", languageId) ?? "-- Select Agent --";
    }

    private async Task LoadTradingAgents()
    {
        try
        {
            tradingAgents = await TradingAgentService.GetAllAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", errorLoadingAgentsLabel, ex.Message);
        }
    }

    private async Task LoadPurchase()
    {
        try
        {
            loading = true;
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            var currentBusinessUnitId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "currentBusinessUnit");
            int businessUnitId = 0;
            if (!string.IsNullOrEmpty(currentBusinessUnitId)) int.TryParse(currentBusinessUnitId, out businessUnitId);

            if (businessUnitId > 0)
            {
                var units = await BusinessUnitService.GetAllAsync();
                currentBusinessUnitName = units.FirstOrDefault(u => u.Id == businessUnitId)?.Name;
            }

            if (!IsEdit)
            {
                var storedCategoryId = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "selectedPurchaseCategoryId");
                await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "selectedPurchaseCategoryId");

                int categoryId = 1; // Default
                if (!string.IsNullOrEmpty(storedCategoryId)) int.TryParse(storedCategoryId, out categoryId);

                purchase = new PurchaseInvoice
                {
                    InvoiceDate = DateTime.Now,
                    Items = new List<PurchaseInvoiceItem>(),
                    CreatedByUserId = userId ?? "",
                    PurchaseCategoryId = categoryId,
                    BusinessUnitId = businessUnitId
                };
            }
            else if (Id.HasValue)
            {
                var loaded = await PurchaseService.GetPurchaseByIdAsync(Id.Value);
                if (loaded != null)
                {
                    purchase = loaded;
                    
                    if (purchase.StatusEnum != PurchaseStatus.Draft)
                    {
                        await JSRuntime.InvokeVoidAsync("alert", 
                            string.Format(purchaseCannotBeEditedLabel, purchase.Status));
                        await GoBack();
                        return;
                    }
                    
                    if (purchase.Items == null) 
                        purchase.Items = new List<PurchaseInvoiceItem>();
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", invoiceNotFoundLabel);
                    Navigation.NavigateTo("/purchases");
                    return;
                }
            }

            editContext = new EditContext(purchase);
            await LoadCategoryName();
            RecalculateTotals();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadCategoryName()
    {
        if (purchase.PurchaseCategoryId > 0)
        {
            var categories = await StateContainer.GetPurchaseCategoriesAsync();
            var cat = categories.FirstOrDefault(c => c.Id == purchase.PurchaseCategoryId);
            if (cat?.NameString?.StringKey != null)
            {
                var langId = await LocalizationService.GetDefaultLanguageId();
                currentCategoryName = LocalizationService.GetString(cat.NameString.StringKey, langId);
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        if (isSaving) return;

        if (purchase.SupplierId <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", pleaseSelectSupplierLabel);
            return;
        }

        if (string.IsNullOrWhiteSpace(purchase.ExternalInvoiceNumber))
        {
            await JSRuntime.InvokeVoidAsync("alert", pleaseEnterSupplierInvoiceNumberLabel);
            return;
        }

        if (purchase.Items == null || !purchase.Items.Any())
        {
            await JSRuntime.InvokeVoidAsync("alert", pleaseAddOneItemLabel);
            return;
        }

        isSaving = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!IsEdit)
            {
                await PurchaseService.CreatePurchaseAsync(purchase);
                await JSRuntime.InvokeVoidAsync("alert", purchaseCreatedSuccessLabel);
            }
            else
            {
                await PurchaseService.UpdatePurchaseAsync(purchase, userId);
                await JSRuntime.InvokeVoidAsync("alert", purchaseUpdatedSuccessLabel);
            }

            await GoBack();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task GoBack()
    {
        var categories = await StateContainer.GetPurchaseCategoriesAsync();
        var cat = categories.FirstOrDefault(c => c.Id == purchase.PurchaseCategoryId);

        if (cat?.Code != null)
        {
            var route = cat.Code.ToUpper() switch
            {
                "P_IMP" => "purchases/import",
                "P_DOM" => "purchases/domestic",
                "P_EXP" => "purchases/expenses",
                "P_DN" => "purchases/debit-note",
                "P_RET" => "purchases/returns",
                "P_REV" => "purchases/reverse-charge",
                _ => "purchases"
            };
            Navigation.NavigateTo($"/{route}");
        }
        else
        {
            Navigation.NavigateTo("/purchases");
        }
    }

