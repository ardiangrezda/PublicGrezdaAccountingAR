    private async Task HandleBarcodeSearch(ChangeEventArgs e, PurchaseInvoiceItem item)
    {
        var term = e.Value?.ToString();
        item.Barcode = term ?? "";

        if (string.IsNullOrWhiteSpace(term) || term.Length < 2)
        {
            barcodeSearchResults.Clear();
            showBarcodeSearch = false;
            return;
        }

        barcodeSearchResults = await ArticleService.SearchArticlesByBarcodeSuffixAsync(term);
        showBarcodeSearch = barcodeSearchResults.Any();
