    private async Task HandleBarcodeChange(PurchaseInvoiceItem item)
    {
        if (string.IsNullOrEmpty(item.Barcode)) return;
        var article = await ArticleService.GetArticleByBarcodeAsync(item.Barcode);
        if (article != null) await SelectArticle(article, item);
    }

    private async Task SelectArticle(Article article, PurchaseInvoiceItem item)
    {
        item.ArticleId = article.Id;
        item.ArticleCode = article.Code;
        item.Description = article.Description;
        item.Barcode = article.Barcode;
        item.UnitId = article.UnitId;
        item.UnitCode = article.Unit?.Code ?? "";
        item.PriceWithVAT = article.Price;
        item.VATPercent = article.VATTable?.VATRate ?? 0;

        showArticleSearch = false;
        showBarcodeSearch = false;
        activeSearchItem = null;

        await CalculateItemTotal(item);
    }

    // Calculations
    private async Task HandleQuantityChange(ChangeEventArgs e, PurchaseInvoiceItem item)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var qty))
        {
            item.Quantity = qty;
            await CalculateItemTotal(item);
        }
    }

    private async Task OnPriceWithoutVatBlurAsync(PurchaseInvoiceItem item)
    {
        item.PriceWithoutVAT = Math.Round(item.PriceWithoutVAT, 2);
        item.PriceWithVAT = Math.Round(item.PriceWithoutVAT * (1 + (item.VATPercent / 100)), 2);
        await CalculateItemTotal(item);
    }

    private async Task OnPriceWithVatBlurAsync(PurchaseInvoiceItem item)
    {
        item.PriceWithVAT = Math.Round(item.PriceWithVAT, 2);
        item.PriceWithoutVAT = Math.Round(item.PriceWithVAT / (1 + (item.VATPercent / 100)), 2);
        await CalculateItemTotal(item);
    }

    private Task CalculateItemTotal(PurchaseInvoiceItem item)
    {
        if (item.Quantity == 0) return Task.CompletedTask;

        item.PriceWithoutVAT = Math.Round(item.PriceWithVAT / (1 + (item.VATPercent / 100)), 2);
        item.ValueWithoutVAT = Math.Round(item.Quantity * item.PriceWithoutVAT, 2);
        item.DiscountAmount = Math.Round(item.ValueWithoutVAT * (item.DiscountPercent / 100), 2);

        var netValue = item.ValueWithoutVAT - item.DiscountAmount;
        item.VATAmount = Math.Round(netValue * (item.VATPercent / 100), 2);

        if (item.DiscountPercent == 0)
            item.ValueWithVAT = Math.Round(item.Quantity * item.PriceWithVAT, 2);
        else
            item.ValueWithVAT = Math.Round(netValue + item.VATAmount, 2);

        RecalculateTotals();
        return Task.CompletedTask;
    }

    private void RecalculateTotals()
    {
        if (purchase.Items == null) return;

        purchase.TotalWithoutVAT = purchase.Items.Sum(i => i.ValueWithoutVAT);
        purchase.TotalDiscountAmount = purchase.Items.Sum(i => i.DiscountAmount);
        purchase.TotalVATAmount = purchase.Items.Sum(i => i.VATAmount);
        purchase.TotalWithVAT = purchase.Items.Sum(i => i.ValueWithVAT);
    }

    private void ResetError()
    {
        errorBoundary?.Recover();
        loading = true;
        StateHasChanged();
        _ = LoadPurchase();
    }
