@page "/purchases/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Models
@using Models.Enums
@using Services
@using System.Security.Claims
@using Shared
@inject PurchaseService PurchaseService
@inject ILocalizationService LocalizationService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject StateContainer StateContainer
@inject Services.CompanySettingsService CompanySettingsService
@attribute [Authorize]

<PageTitle>@purchaseDetailsLabel</PageTitle>

@if (invoice is not null)
{
    <div class="container-fluid px-4">
        <div class="row">
            <div class="col-12">
                <nav aria-label="breadcrumb" class="no-print">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/purchases">@purchasesLabel</a>
                        </li>
                        <li class="breadcrumb-item active">@invoiceNumberLabel</li>
                    </ol>
                </nav>

                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center no-print">
                        <h3 class="mb-0">@invoiceNumberLabel: @invoice.InvoiceNumber</h3>
                        <div>
                            @switch (invoice.StatusEnum)
                            {
                                case PurchaseStatus.Draft:
                                    <span class="badge bg-secondary me-2">@draftLabel</span>
                                    break;
                                case PurchaseStatus.Approved:
                                    <span class="badge bg-info me-2">@approvedLabel</span>
                                    break;
                                case PurchaseStatus.Received:
                                    <span class="badge bg-primary me-2">@receivedLabel</span>
                                    break;
                                case PurchaseStatus.Posted:
                                    <span class="badge bg-success me-2">@postedLabel</span>
                                    break;
                                case PurchaseStatus.Paid:
                                    <span class="badge bg-dark me-2">@paidLabel</span>
                                    break;
                                case PurchaseStatus.OnHold:
                                    <span class="badge bg-warning me-2">@onHoldLabel</span>
                                    break;
                                case PurchaseStatus.Cancelled:
                                    <span class="badge bg-danger me-2">@cancelledLabel</span>
                                    break;
                            }
                            
                            @if (invoice.StatusEnum == PurchaseStatus.Draft)
                            {
                                <button class="btn btn-primary btn-sm" @onclick="EditInvoice">
                                    <i class="fas fa-edit"></i> @editLabel
                                </button>
                            }
                        </div>
                    </div>
                    
                    <!-- This is the printable content -->
                    <div class="card-body" id="printable-invoice">
                        <!-- Print Header - Only visible when printing -->
                        <div class="print-only">
                            <div class="text-center mb-4">
                                <h2>@purchaseInvoiceLabel</h2>
                                <h4>@invoiceNumberLabel: @invoice.InvoiceNumber</h4>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <!-- BUYER INFORMATION (LEFT COLUMN - Our Company) -->
                            <div class="col-md-6">
                                <h5 class="border-bottom pb-2">@buyerLabel</h5>
                                @if (companySettings != null)
                                {
                                    <table class="table table-borderless">
                                        <tr>
                                            <td class="text-muted" style="width:40%">@companyNameLabel:</td>
                                            <td class="fw-bold">@companySettings.CompanyName</td>
                                        </tr>
                                        @if (!string.IsNullOrEmpty(companySettings.VATNumber))
                                        {
                                            <tr>
                                                <td class="text-muted">@vatNumberLabel:</td>
                                                <td>@companySettings.VATNumber</td>
                                            </tr>
                                        }
                                        @if (!string.IsNullOrEmpty(companySettings.BusinessRegistrationNumber))
                                        {
                                            <tr>
                                                <td class="text-muted">@businessRegistrationNumberLabel:</td>
                                                <td>@companySettings.BusinessRegistrationNumber</td>
                                            </tr>
                                        }
                                        @if (!string.IsNullOrEmpty(companySettings.NUI))
                                        {
                                            <tr>
                                                <td class="text-muted">@nuiLabel:</td>
                                                <td>@companySettings.NUI</td>
                                            </tr>
                                        }
                                        @if (!string.IsNullOrEmpty(companySettings.Address))
                                        {
                                            <tr>
                                                <td class="text-muted">@addressLabel:</td>
                                                <td>@companySettings.Address</td>
                                            </tr>
                                        }
                                        @if (!string.IsNullOrEmpty(companySettings.PhoneNumber))
                                        {
                                            <tr>
                                                <td class="text-muted">@phoneNumberLabel:</td>
                                                <td>@companySettings.PhoneNumber</td>
                                            </tr>
                                        }
                                    </table>
                                }
                                else
                                {
                                    <p class="text-muted">@loadingLabel</p>
                                }
                            </div>

                            <!-- SUPPLIER INFORMATION (RIGHT COLUMN) -->
                            <div class="col-md-6">
                                <h5 class="border-bottom pb-2">@supplierLabel</h5>
                                <table class="table table-borderless">
                                    <tr>
                                        <td class="text-muted" style="width:30%">@supplierNameLabel:</td>
                                        <td class="fw-bold">@invoice.SupplierName</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">@codeHeaderLabel:</td>
                                        <td>@invoice.SupplierCode</td>
                                    </tr>
                                    @if (invoice.Supplier != null)
                                    {
                                        @if (!string.IsNullOrEmpty(invoice.Supplier.Address))
                                        {
                                            <tr>
                                                <td class="text-muted">@addressLabel:</td>
                                                <td>@invoice.Supplier.Address</td>
                                            </tr>
                                        }
                                    }
                                </table>
                            </div>
                        </div>

                        <!-- INVOICE SUMMARY (BELOW BUYER/SUPPLIER) -->
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <h5 class="border-bottom pb-2">@invoiceSummaryLabel</h5>
                                <table class="table table-borderless">
                                    <tr>
                                        <td class="text-muted" style="width:20%">@internalNrLabel:</td>
                                        <td class="fw-bold">@invoice.InvoiceNumber</td>
                                        <td class="text-muted" style="width:20%">@invoiceDateLabel:</td>
                                        <td>@invoice.InvoiceDate.ToShortDateString()</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">@supplierInvoiceNumberLabel:</td>
                                        <td class="fw-bold">@invoice.ExternalInvoiceNumber</td>
                                        <td class="text-muted">@statusLabel:</td>
                                        <td>
                                            @switch (invoice.StatusEnum)
                                            {
                                                case PurchaseStatus.Draft:
                                                    <span class="badge bg-secondary">@draftLabel</span>
                                                    break;
                                                case PurchaseStatus.Approved:
                                                    <span class="badge bg-info">@approvedLabel</span>
                                                    break;
                                                case PurchaseStatus.Received:
                                                    <span class="badge bg-primary">@receivedLabel</span>
                                                    break;
                                                case PurchaseStatus.Posted:
                                                    <span class="badge bg-success">@postedLabel</span>
                                                    break;
                                                case PurchaseStatus.Paid:
                                                    <span class="badge bg-dark">@paidLabel</span>
                                                    break;
                                                case PurchaseStatus.OnHold:
                                                    <span class="badge bg-warning">@onHoldLabel</span>
                                                    break;
                                                case PurchaseStatus.Cancelled:
                                                    <span class="badge bg-danger">@cancelledLabel</span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                    @if (invoice.InvoiceExpiryDate.HasValue)
                                    {
                                        <tr>
                                            <td class="text-muted">@expiryDateLabel:</td>
                                            <td>@invoice.InvoiceExpiryDate.Value.ToShortDateString()</td>
                                            <td class="text-muted">@createdAtLabel:</td>
                                            <td>@invoice.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td class="text-muted">@createdAtLabel:</td>
                                            <td colspan="3">@invoice.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(invoice.Shipment))
                                    {
                                        <tr>
                                            <td class="text-muted">@shipmentLabel:</td>
                                            <td colspan="3">@invoice.Shipment</td>
                                        </tr>
                                    }
                                    @if (invoice.IsReturn && !string.IsNullOrEmpty(invoice.OriginalInvoiceNumber))
                                    {
                                        <tr>
                                            <td class="text-muted">@originalInvoiceLabel:</td>
                                            <td colspan="3">@invoice.OriginalInvoiceNumber</td>
                                        </tr>
                                    }
                                    @if (invoice.IsReturn && !string.IsNullOrEmpty(invoice.ReturnReason))
                                    {
                                        <tr>
                                            <td class="text-muted">@returnReasonLabel:</td>
                                            <td colspan="3" class="text-warning">@invoice.ReturnReason</td>
                                        </tr>
                                    }
                                    @if (invoice.LastModifiedAt.HasValue)
                                    {
                                        <tr>
                                            <td class="text-muted">@lastModifiedLabel:</td>
                                            <td colspan="3">@invoice.LastModifiedAt.Value.ToString("yyyy-MM-dd HH:mm")</td>
                                        </tr>
                                    }
                                    @if (invoice.IsCancelled && !string.IsNullOrEmpty(invoice.CancellationReason))
                                    {
                                        <tr>
                                            <td class="text-muted">@cancellationReasonLabel:</td>
                                            <td colspan="3" class="text-danger">@invoice.CancellationReason</td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        </div>

                        <h5 class="border-bottom pb-2">@invoiceItemsLabel</h5>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-striped">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>@codeHeaderLabel</th>
                                        <th>@descriptionLabel</th>
                                        <th class="text-end">@quantityLabel</th>
                                        <th class="text-center">@unitLabel</th>
                                        <th class="text-end">@priceExclLabel</th>
                                        <th class="text-end">@discPercentLabel</th>
                                        <th class="text-end">@vatPercentLabel</th>
                                        <th class="text-end">@valueExclLabel</th>
                                        <th class="text-end">@valueInclLabel</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (invoice.Items != null && invoice.Items.Any())
                                    {
                                        @foreach (var (item, index) in invoice.Items.Select((item, i) => (item, i + 1)))
                                        {
                                            <tr>
                                                <td class="text-center">@index</td>
                                                <td>@item.ArticleCode</td>
                                                <td>@item.Description</td>
                                                <td class="text-end">@FormatQuantity(item.Quantity)</td>
                                                <td class="text-center">@item.UnitCode</td>
                                                <td class="text-end">@item.PriceWithoutVAT.ToString("F2")</td>
                                                <td class="text-end">@item.DiscountPercent.ToString("F2")%</td>
                                                <td class="text-end">@item.VATPercent.ToString("F2")%</td>
                                                <td class="text-end">@item.ValueWithoutVAT.ToString("F2")</td>
                                                <td class="text-end">@item.ValueWithVAT.ToString("F2")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="10" class="text-center">@noItemsFoundLabel</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="bg-light fw-bold">
                                        <td colspan="8" class="text-end">@totalsLabel</td>
                                        <td class="text-end">@invoice.TotalWithoutVAT.ToString("F2")</td>
                                        <td class="text-end">@invoice.TotalWithVAT.ToString("F2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="row">
                            <div class="col-md-6 offset-md-6">
                                <div class="card">
                                    <div class="card-header bg-success text-white">
                                        <h5 class="mb-0">@invoiceSummaryLabel</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>@subtotalBeforeDiscountLabel:</span>
                                            <span class="fw-bold">@((invoice.TotalWithoutVAT + invoice.TotalDiscountAmount).ToString("F2"))</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>@totalDiscountsLabel:</span>
                                            <span class="fw-bold text-danger">-@invoice.TotalDiscountAmount.ToString("F2")</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-3">
                                            <span>@totalVatLabel:</span>
                                            <span class="fw-bold">@invoice.TotalVATAmount.ToString("F2")</span>
                                        </div>
                                        <div class="bg-success text-white p-3 rounded">
                                            <div class="d-flex justify-content-between">
                                                <span class="h5 mb-0">@totalDueLabel:</span>
                                                <span class="h5 mb-0">@invoice.TotalWithVAT.ToString("F2") @(invoice.Items?.FirstOrDefault()?.CurrencyCode ?? "EUR")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-footer no-print">
                        <div class="d-flex justify-content-between">
                            <button class="btn btn-secondary" @onclick="GoBack">
                                <i class="fas fa-arrow-left"></i> @backToPurchasesLabel
                            </button>
                            <div>
                                @if (invoice.StatusEnum == PurchaseStatus.Draft)
                                {
                                    <button class="btn btn-success me-2" @onclick="() => ChangeStatus(PurchaseStatus.Approved)">
                                        <i class="fas fa-check-circle"></i> @approveLabel
                                    </button>
                                    <button class="btn btn-danger me-2" @onclick="CancelInvoice">
                                        <i class="fas fa-times-circle"></i> @cancelLabel
                                    </button>
                                    <button class="btn btn-primary me-2" @onclick="EditInvoice">
                                        <i class="fas fa-edit"></i> @editLabel
                                    </button>
                                }
                                else if (invoice.StatusEnum == PurchaseStatus.Approved)
                                {
                                    <button class="btn btn-primary me-2" @onclick="() => ChangeStatus(PurchaseStatus.Received)">
                                        <i class="fas fa-truck"></i> @markAsReceivedLabel
                                    </button>
                                    <button class="btn btn-warning me-2" @onclick="() => ChangeStatus(PurchaseStatus.OnHold)">
                                        <i class="fas fa-pause"></i> @putOnHoldLabel
                                    </button>
                                }
                                else if (invoice.StatusEnum == PurchaseStatus.Received)
                                {
                                    <button class="btn btn-success me-2" @onclick="() => ChangeStatus(PurchaseStatus.Posted)">
                                        <i class="fas fa-book"></i> @postToAccountingLabel
                                    </button>
                                }
                                else if (invoice.StatusEnum == PurchaseStatus.Posted)
                                {
                                    <button class="btn btn-success me-2" @onclick="() => ChangeStatus(PurchaseStatus.Paid)">
                                        <i class="fas fa-dollar-sign"></i> @markAsPaidLabel
                                    </button>
                                }
                                else if (invoice.StatusEnum == PurchaseStatus.OnHold)
                                {
                                    <button class="btn btn-primary me-2" @onclick="() => ChangeStatus(PurchaseStatus.Approved)">
                                        <i class="fas fa-play"></i> @resumeLabel
                                    </button>
                                }
                                <button class="btn btn-info" @onclick="PrintInvoice">
                                    <i class="fas fa-print"></i> @printLabel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (loading)
{
    <div class="text-center p-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">@loadingLabel</span>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning m-5">
        <h4>@invoiceNotFoundLabel</h4>
        <p>@invoiceDoesNotExistLabel</p>
        <a href="/purchases" class="btn btn-primary"> @backToPurchasesLabel</a>
    </div>
}

<!-- Print Styles (same as SalesInvoiceDetail) -->
<style>
    @@media print {
        * {
            margin: 0 !important;
            padding: 0 !important;
            box-sizing: border-box !important;
        }
        
        body * {
            visibility: hidden;
        }
        
        html, body {
            height: auto !important;
            width: auto !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: visible !important;
        }
        
        .no-print,
        .no-print *,
        nav,
        .navbar,
        .sidebar,
        .breadcrumb,
        .card-header,
        .card-footer,
