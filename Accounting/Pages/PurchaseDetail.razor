    private async Task GoBack()
    {
        try
        {
            var categories = await StateContainer.GetPurchaseCategoriesAsync();
            var category = categories.FirstOrDefault(c => c.Id == invoice.PurchaseCategoryId);
            
            if (category?.Code != null)
            {
                var categoryRoute = GetCategoryRoute(category.Code);
                Navigation.NavigateTo($"/{categoryRoute}");
            }
            else
            {
                Navigation.NavigateTo("/purchases");
            }
        }
        catch
        {
            Navigation.NavigateTo("/purchases");
        }
    }

    private string GetCategoryRoute(string code)
    {
        return code.ToUpper() switch
        {
            "P_IMP" => "purchases/import",
            "P_DOM" => "purchases/domestic",
            "P_EXP" => "purchases/expenses",
            "P_DN" => "purchases/debit-note",
            "P_RET" => "purchases/returns",
            "P_REV" => "purchases/reverse-charge",
            _ => "purchases"
        };
    }

    private void EditInvoice()
    {
        if (invoice != null && invoice.StatusEnum == PurchaseStatus.Draft)
        {
            Navigation.NavigateTo($"/purchases/edit/{Id}");
        }
    }

    private async Task ChangeStatus(PurchaseStatus newStatus)
    {
        if (invoice == null || string.IsNullOrEmpty(userId))
            return;

        try
        {
            var statusName = GetLocalizedStatusName(newStatus);
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"{confirmChangeStatusLabel}: {statusName}?");
            
            if (confirmed)
            {
                await PurchaseService.ChangeStatusAsync(Id, newStatus, userId);
                invoice = await PurchaseService.GetPurchaseByIdAsync(Id);
                await JSRuntime.InvokeVoidAsync("alert", $"{statusChangedSuccessLabel}: {statusName}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"{errorChangingStatusLabel}: {ex.Message}");
        }
    }

    private async Task CancelInvoice()
    {
        if (invoice == null || invoice.StatusEnum != PurchaseStatus.Draft || string.IsNullOrEmpty(userId))
            return;

        try
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", confirmCancelPurchaseLabel);
            
            if (confirmed)
            {
                string reason = await JSRuntime.InvokeAsync<string>("prompt", provideReasonForCancelLabel, "");
                
                if (!string.IsNullOrWhiteSpace(reason))
                {
                    await PurchaseService.ChangeStatusAsync(Id, PurchaseStatus.Cancelled, userId, reason);
                    invoice = await PurchaseService.GetPurchaseByIdAsync(Id);
                    await JSRuntime.InvokeVoidAsync("alert", purchaseCancelledSuccessLabel);
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"{errorCancellingPurchaseLabel}: {ex.Message}");
        }
    }

    private async Task PrintInvoice()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"{errorPrintingInvoiceLabel}: {ex.Message}");
        }
    }

    private string FormatQuantity(decimal quantity)
    {
        if (quantity == Math.Floor(quantity))
        {
            return quantity.ToString("0");
        }
        return quantity.ToString("0.##");
    }

    private string GetLocalizedStatusName(PurchaseStatus status)
    {
        return status switch
        {
            PurchaseStatus.Draft => draftLabel,
            PurchaseStatus.Approved => approvedLabel,
            PurchaseStatus.Received => receivedLabel,
            PurchaseStatus.Posted => postedLabel,
            PurchaseStatus.Paid => paidLabel,
            PurchaseStatus.Cancelled => cancelledLabel,
            PurchaseStatus.OnHold => onHoldLabel,
            _ => status.ToString()
        };
    }
