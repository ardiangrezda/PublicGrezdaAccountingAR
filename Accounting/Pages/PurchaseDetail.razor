        }
        
        .text-end {
            text-align: right !important;
        }
        
        .text-center {
            text-align: center !important;
        }
        
        @@page {
            margin: 0.5in !important;
            size: A4 !important;
        }
    }
    
    .print-only {
        display: none;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private PurchaseInvoice? invoice;
    private CompanySettings? companySettings;
    private bool loading = true;
    private string? userId;

    // Localization variables
    private string invoiceNumberLabel = string.Empty;
    private string buyerLabel = string.Empty;
    private string supplierLabel = string.Empty;
    private string supplierNameLabel = string.Empty;
    private string invoiceDateLabel = string.Empty;
    private string codeHeaderLabel = string.Empty;
    private string addressLabel = string.Empty;
    private string invoiceItemsLabel = string.Empty;
    private string descriptionLabel = string.Empty;
    private string quantityLabel = string.Empty;
    private string unitLabel = string.Empty;
    private string priceExclLabel = string.Empty;
    private string discPercentLabel = string.Empty;
    private string valueExclLabel = string.Empty;
    private string valueInclLabel = string.Empty;
    private string totalsLabel = string.Empty;
    private string invoiceSummaryLabel = string.Empty;
    private string subtotalBeforeDiscountLabel = string.Empty;
    private string totalDiscountsLabel = string.Empty;
    private string totalVatLabel = string.Empty;
    private string totalDueLabel = string.Empty;
    private string editLabel = string.Empty;
    private string expiryDateLabel = string.Empty;
    private string createdAtLabel = string.Empty;
    private string lastModifiedLabel = string.Empty;
    private string cancellationReasonLabel = string.Empty;
    private string originalInvoiceLabel = string.Empty;
    private string returnReasonLabel = string.Empty;
    private string printLabel = string.Empty;
    private string invoiceNotFoundLabel = string.Empty;
    private string invoiceDoesNotExistLabel = string.Empty;
    private string loadingLabel = string.Empty;
    private string companyNameLabel = string.Empty;
    private string vatNumberLabel = string.Empty;
    private string businessRegistrationNumberLabel = string.Empty;
    private string nuiLabel = string.Empty;
    private string phoneNumberLabel = string.Empty;
    private string purchasesLabel = string.Empty;
    private string draftLabel = string.Empty;
    private string postedLabel = string.Empty;
    private string cancelledLabel = string.Empty;
    private string purchaseDetailsLabel = string.Empty;
    private string approvedLabel = string.Empty;
    private string receivedLabel = string.Empty;
    private string paidLabel = string.Empty;
    private string onHoldLabel = string.Empty;
    private string vatPercentLabel = string.Empty;
    private string noItemsFoundLabel = string.Empty;
    private string purchaseInvoiceLabel = string.Empty;
    private string statusLabel = string.Empty;
    private string supplierInvoiceNumberLabel = string.Empty;
    private string shipmentLabel = string.Empty;
    private string cancelLabel = string.Empty;
    private string backToPurchasesLabel = string.Empty;
    private string approveLabel = string.Empty;
    private string markAsReceivedLabel = string.Empty;
    private string putOnHoldLabel = string.Empty;
    private string postToAccountingLabel = string.Empty;
    private string markAsPaidLabel = string.Empty;
    private string resumeLabel = string.Empty;
    private string errorLoadingPurchaseLabel = string.Empty;
    private string errorSettingCategoryLabel = string.Empty;
    private string provideReasonForCancelLabel = string.Empty;
    private string confirmChangeStatusLabel = string.Empty;
    private string statusChangedSuccessLabel = string.Empty;
    private string errorChangingStatusLabel = string.Empty;
    private string confirmCancelPurchaseLabel = string.Empty;
    private string purchaseCancelledSuccessLabel = string.Empty;
    private string errorCancellingPurchaseLabel = string.Empty;
    private string errorPrintingInvoiceLabel = string.Empty;
    private string internalNrLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadLocalizationStrings();

        try
        {
            loading = true;
            
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            
            invoice = await PurchaseService.GetPurchaseByIdAsync(Id);
            companySettings = await CompanySettingsService.GetOrCreateSettingsAsync();

            if (invoice != null && invoice.PurchaseCategoryId > 0)
            {
                try
                {
                    var categories = await StateContainer.GetPurchaseCategoriesAsync();
                    var category = categories.FirstOrDefault(c => c.Id == invoice.PurchaseCategoryId);
                    if (category?.Code != null)
                    {
                        await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "currentPurchaseCategory", category.Code);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"{errorSettingCategoryLabel}: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", errorLoadingPurchaseLabel, ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadLocalizationStrings()
    {
